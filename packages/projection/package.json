    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@teneolog/domain": "*",
    "@teneolog/points": "*",
    "@teneolog/swept-path": "*",
    "@teneolog/topology": "*"
  },
  "devDependencies": {
    "vitest": "^2.1.4"
  }
}
